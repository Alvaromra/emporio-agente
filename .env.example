# Copie para .env e ajuste se necessário. Todos os valores abaixo são opcionais.

# Diretório dos dados originais da loja (CSVs e manual em PDF).
EMPORIO_RAW_DIR=data/raw

# Banco SQLite gerado pelo ETL e consultado pelo agente.
EMPORIO_DB_PATH=data/processed/store.db

# Fuso horário da loja (Campo Grande/MS, UTC-4, sem horário de verão).
EMPORIO_TIMEZONE=America/Campo_Grande

# Congela o "agora" do agente (ISO 8601). Útil para testes e avaliações
# reproduzíveis, já que prazos de entrega e devolução dependem da data atual.
# EMPORIO_NOW=2026-10-31T10:30

# Segredo usado para pseudonimizar e-mail e telefone dos clientes (HMAC-SHA256).
# O ETL e o agente precisam usar o mesmo valor; se mudar, rode o ETL de novo.
# Sem ele, um valor de desenvolvimento é usado (com aviso).
# EMPORIO_PII_PEPPER=troque-por-um-segredo-longo-e-aleatorio

# ---------------------------------------------------------------- Modelo (LLM)
# Provedor: gemini (padrão, Gemini API) ou ollama (modelo local).
EMPORIO_LLM_PROVIDER=gemini

# Chave gratuita da Gemini API: https://aistudio.google.com/apikey
# Nunca faça commit do .env com a chave.
GEMINI_API_KEY=

# Modelo. Padrões: gemma-4-26b-a4b-it (gemini) e gemma4:e4b (ollama).
# EMPORIO_LLM_MODEL=gemma-4-31b-it

# Temperatura baixa favorece respostas consistentes e fiéis às ferramentas.
# EMPORIO_LLM_TEMPERATURE=0.3

# Ollama: endereço do servidor e modo de raciocínio do Gemma 4 (true/false).
# OLLAMA_HOST=http://localhost:11434
# EMPORIO_OLLAMA_THINK=false
