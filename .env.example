# Copie para .env e ajuste se necessário. Todos os valores abaixo são opcionais.

# Diretório dos dados originais da loja (CSVs e manual em PDF).
EMPORIO_RAW_DIR=data/raw

# Banco SQLite gerado pelo ETL e consultado pelo agente.
EMPORIO_DB_PATH=data/processed/store.db

# Fuso horário da loja (Campo Grande/MS, UTC-4, sem horário de verão).
EMPORIO_TIMEZONE=America/Campo_Grande

# Congela o "agora" do agente (ISO 8601). Útil para testes e avaliações
# reproduzíveis, já que prazos de entrega e devolução dependem da data atual.
# EMPORIO_NOW=2026-10-31T10:30
